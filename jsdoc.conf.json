{
  "source": {
    "include": ["src", "README.md"],
    "includePattern": ".+\\.(js|ts)(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": [
    "plugins/markdown",
    "plugins/summarize"
  ],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true
  },
  "opts": {
    "encoding": "utf8",
    "destination": "./docs/jsdoc/",
    "recurse": true,
    "verbose": true
  }
}